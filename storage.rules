rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Match the post_images path specifically
    match /post_images/{userId}/{imageId} {
      // Allow read access to everyone
      allow read: if true;
      
      // Allow write access only to authenticated users for their own directory
      allow write: if request.auth != null 
                  && request.auth.uid == userId
                  && request.resource.size < 5 * 1024 * 1024 // 5MB max
                  && request.resource.contentType.matches('image/.*');
    }
    
    // Default rule for other paths
    match /{allPaths=**} {
      allow read: if true;
      allow write: if false; // Restrict write access to undefined paths
    }
  }
} 